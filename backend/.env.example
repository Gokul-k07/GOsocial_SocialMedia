PORT=8000
MONGODB_URI=mongodb://localhost:27017/gosocial
JWT_SECRET=your_jwt_secret_here

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASS=your_brevo_smtp_password
BREVO_FROM_EMAIL=your_verified_sender_email
BREVO_FROM_NAME=GOsocial
FRONTEND_URL=http://localhost:5173

# ── GOSocial AI (RAG Feature) ──────────────────────────────────────────────────
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
# Used ONLY for final answer generation — embeddings are handled by MongoDB Atlas.
GEMINI_API_KEY=your_gemini_api_key_here
# LLM for answer generation
LLM_MODEL=gemini-3.6-flash
# Name of the MongoDB Atlas Vector Search index on the posts collection
MONGODB_VECTOR_INDEX=post_embedding_index
